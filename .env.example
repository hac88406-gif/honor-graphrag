# ============================================================
# 复制为 .env 后按需修改。所有键均可在 app/config.py 中找到对应定义。
# 不要在版本库中提交 .env（已在 .gitignore 中排除）。
# ============================================================

# --- 服务 ---
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=1

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=honor-graphrag
NEO4J_CONNECT_TIMEOUT=5.0

# --- Chroma ---
CHROMA_PERSIST_DIR=data/chroma

# --- LLM ---
# local=全本地(Ollama)；cloud=全部云端；hybrid=意图本地/生成云端
LLM_MODE=local
OLLAMA_BASE_URL=http://localhost:11434
INTENT_MODEL=qwen2.5:3b
# 云端 key 到位后填入，并切 LLM_MODE=hybrid
CLOUD_API_KEY=
CLOUD_BASE_URL=
CLOUD_CHAT_MODEL=
LLM_TIMEOUT=30.0
# 推理模型的 completion_tokens 含思考，512 会触发 finish_reason=length + 空答案，故取 2048
LLM_MAX_TOKENS=2048
# M6 评测判官（scripts/eval_judge.py）独立预算：判官要先读资料再比对，长资料思考更长，
# 沿用 2048 会返回空答案（实测 5/78 条），故给 2 倍
JUDGE_MAX_TOKENS=4096
# 答案生成方式：llm=云端生成 + 生成后校验；template=确定性证据组装（离线可测，测试默认）
GENERATION_MODE=template
# 生成后校验：拦截「把资料里的解释当类别」等越界归纳（4.9 生成约束补强）
GUARD_ENABLED=True

# --- Embedding ---
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 本地模型目录（scripts/download_embedding_model.py 从 ModelScope 拉取）；存在时优先本地加载
EMBEDDING_MODEL_DIR=models/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu

# --- 版本（1.9 统一口径：最近 3 个 patch） ---
CURRENT_PATCH=2026-10
PATCH_WINDOW=["2026-10","2026-09","2026-08"]

# --- 置信度阈值（M6 校准后回写） ---
CONF_LOW=0.45
CONF_HIGH=0.60
# 图谱单路 confidence 映射（4.9 v1.5：按关系条数；≥1 条即正常回答，不降级）
CONF_GRAPH_1=0.60
CONF_GRAPH_2=0.75
CONF_GRAPH_3=0.85
ENTITY_CONFIDENCE_THRESHOLD=0.7

# --- 检索 ---
VECTOR_TOP_K=5
BM25_TOP_K=5
RRF_K=60
USE_BM25=True
